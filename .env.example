DATABASE_URL="file:./dev.db"
GITHUB_ID="your-github-id"
GITHUB_SECRET="your-github-secret"
NEXTAUTH_SECRET="your-nextauth-secret"
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
NEXTAUTH_URL="http://localhost:5173"
ADMIN_EMAILS="youremail1@gmail.com,youremail2@gmail.com"
VITE_LASTFM_USERNAME=your-lastfm-username
VITE_LASTFM_API_KEY=your-lastfm-api-key
VITE_MEDIUM_USERNAME=your-medium-username
# Anki tracker (add-on pushes here)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
ANKI_TRACKER_TOKEN=
VITE_ANKI_API=/api/anki
# Homelab tracker (Docker collector on the lab pushes here)
HOMELAB_TRACKER_TOKEN=
VITE_HOMELAB_API=/api/homelab
# Homelab public shell (worker container polls with this token)
HOMELAB_SHELL_TOKEN=
