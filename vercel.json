{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/anki",
      "destination": "/api/anki"
    },
    {
      "source": "/api/terminal",
      "destination": "/api/terminal"
    },
    {
      "source": "/api/lastfm",
      "destination": "/api/lastfm"
    },
    {
      "source": "/api/homelab",
      "destination": "https://takamatsu.tailb43e01.ts.net/homelab-status"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
